<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Same as fastdds_local.xml (16 MB shared-memory segment for the camera images on the robot) but
  UDP on every interface, so a laptop on the same network and ROS_DOMAIN_ID sees the topics.
  Loaded by env_jetson.sh when CLOTHOID_REMOTE=1. Images to the laptop still go over Wi-Fi UDP.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>shm_16mb</transport_id>
      <type>SHM</type>
      <segment_size>16777216</segment_size>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>udp_all</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="clothoid_remote" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>shm_16mb</transport_id>
        <transport_id>udp_all</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
