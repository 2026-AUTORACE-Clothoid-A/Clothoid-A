<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>clothoid_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and shared configuration (topics, twist_mux) for the Clothoid-A LIMO</description>
  <maintainer email="todo@example.com">Clothoid-A</maintainer>
  <license>TODO</license>

  <!-- latency_monitor -->
  <exec_depend>clothoid_common</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <exec_depend>twist_mux</exec_depend>
  <exec_depend>topic_tools</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <!-- provided by the LIMO image (~/wego_ws), not available via apt -->
  <exec_depend>limo_base</exec_depend>
  <exec_depend>limo_description</exec_depend>
  <exec_depend>orbbec_camera</exec_depend>
  <exec_depend>ydlidar_ros2_driver</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <!-- mission packages started by full.launch.py -->
  <exec_depend>clothoid_lane</exec_depend>
  <exec_depend>clothoid_yolo</exec_depend>
  <exec_depend>clothoid_lidar</exec_depend>
  <exec_depend>clothoid_parking</exec_depend>
  <exec_depend>clothoid_finish</exec_depend>
  <exec_depend>clothoid_mission</exec_depend>
  <exec_depend>clothoid_debug</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
