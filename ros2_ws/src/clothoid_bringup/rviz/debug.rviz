Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: base_link
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (1 m)
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 10
      Color: 90; 90; 90
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Marker Scale: 0.3
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/LaserScan
      Name: Lidar /scan
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
      Style: Spheres
      Size (m): 0.03
      Color Transformer: FlatColor
      Color: 255; 40; 40
      Decay Time: 0
    - Class: rviz_default_plugins/PoseArray
      Name: Cones /lidar/obstacles
      Enabled: true
      Topic:
        Value: /lidar/obstacles
      Shape: Arrow (Flat)
      Color: 255; 170; 0
      Arrow Length: 0.1
    - Class: rviz_default_plugins/Path
      Name: Cone left boundary
      Enabled: true
      Topic:
        Value: /cone/left_boundary
      Color: 40; 120; 255
      Line Style: Billboards
      Line Width: 0.03
    - Class: rviz_default_plugins/Path
      Name: Cone right boundary
      Enabled: true
      Topic:
        Value: /cone/right_boundary
      Color: 255; 255; 40
      Line Style: Billboards
      Line Width: 0.03
    - Class: rviz_default_plugins/Path
      Name: Cone centerline
      Enabled: true
      Topic:
        Value: /cone/centerline
      Color: 40; 255; 40
      Line Style: Billboards
      Line Width: 0.05
    - Class: rviz_default_plugins/Odometry
      Name: Odom /odom
      Enabled: false
      Topic:
        Value: /odom
        Reliability Policy: Best Effort
      Keep: 50
      Shape:
        Value: Arrow
    - Class: rviz_default_plugins/Image
      Name: Camera
      Enabled: true
      Topic:
        Value: /camera/color/image_raw
        Reliability Policy: Best Effort
      Normalize Range: true
    - Class: rviz_default_plugins/Image
      Name: Lane debug
      Enabled: true
      Topic:
        Value: /lane/debug_image
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/Image
      Name: Stopline debug
      Enabled: false
      Topic:
        Value: /stopline/debug_image
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/Image
      Name: Speed zone debug
      Enabled: false
      Topic:
        Value: /speed_zone/debug_image
        Reliability Policy: Best Effort
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top view
      Scale: 120
      Angle: 0
      X: 1.0
      Y: 0.0
      Invert Z Axis: false
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1500
