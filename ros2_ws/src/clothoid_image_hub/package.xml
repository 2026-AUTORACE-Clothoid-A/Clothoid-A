<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>clothoid_image_hub</name>
  <version>0.1.0</version>
  <description>C++ image hub: receives the 30 Hz raw camera image once (intra-process in the camera container) and publishes the small topics the Python nodes need (10 Hz, 320x240, BEV).</description>
  <maintainer email="hjy121080@gmail.com">heojy</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>libopencv-dev</depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>clothoid_lane</exec_depend>   <!-- config/camera_<car>.yaml for the BEV warp -->
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
