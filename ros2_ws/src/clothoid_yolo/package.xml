<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>clothoid_yolo</name>
  <version>0.1.0</version>
  <description>YOLO inference node: camera image to clothoid_interfaces/DetectionArray</description>
  <maintainer email="todo@example.com">Clothoid-A</maintainer>
  <license>TODO</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>clothoid_common</depend>
  <depend>clothoid_interfaces</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <!-- ultralytics (and the JetPack torch build) are pip-only, see clothoid_yolo/README.md -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
