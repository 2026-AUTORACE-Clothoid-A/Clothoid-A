<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>clothoid_parking</name>
  <version>0.1.0</version>
  <description>T-parking 2026: lidar empty-bay search and one forward arc into the bay</description>
  <maintainer email="todo@example.com">Clothoid-A</maintainer>
  <license>TODO</license>

  <depend>rclpy</depend>
  <depend>clothoid_common</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>builtin_interfaces</depend>
  <exec_depend>clothoid_common</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>clothoid_lane</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>compressed_image_transport</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
