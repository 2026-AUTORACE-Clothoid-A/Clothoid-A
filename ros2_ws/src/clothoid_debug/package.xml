<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>clothoid_debug</name>
  <version>0.1.0</version>
  <description>RViz view of what the nodes saw and decided, live or on a bag. Sends no drive command.</description>
  <maintainer email="todo@example.com">Clothoid-A</maintainer>
  <license>TODO</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>clothoid_common</depend>
  <depend>clothoid_interfaces</depend>
  <!-- bag.launch.py also needs clothoid_bringup at run time; not declared because bringup depends on this package -->
  <exec_depend>clothoid_lane</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <!-- lane_viewer reads bags directly -->
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>compressed_image_transport</exec_depend>
  <exec_depend>clothoid_lidar</exec_depend>
  <exec_depend>clothoid_mission</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
