Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: track
    Frame Rate: 30
    Background Color: 30; 30; 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (1 m, track)
      Enabled: true
      Reference Frame: track
      Cell Size: 1
      Plane Cell Count: 30
      Color: 80; 80; 80
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Arrows: false
      Show Axes: true
      Marker Scale: 0.3
    - Class: rviz_default_plugins/LaserScan
      Name: Lidar /scan
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
      Style: Spheres
      Size (m): 0.02
      Color Transformer: FlatColor
      Color: 255; 60; 60
      Decay Time: 0
    - Class: rviz_default_plugins/PoseArray
      Name: Obstacles /lidar/obstacles
      Enabled: true
      Topic:
        Value: /lidar/obstacles
      Shape: Axes
      Axes Length: 0.1
      Axes Radius: 0.02
    - Class: rviz_default_plugins/Path
      Name: Cone left
      Enabled: true
      Topic:
        Value: /cone/left_boundary
      Color: 40; 120; 255
      Line Style: Billboards
      Line Width: 0.03
    - Class: rviz_default_plugins/Path
      Name: Cone right
      Enabled: true
      Topic:
        Value: /cone/right_boundary
      Color: 255; 255; 40
      Line Style: Billboards
      Line Width: 0.03
    - Class: rviz_default_plugins/Path
      Name: Cone centerline
      Enabled: true
      Topic:
        Value: /cone/centerline
      Color: 40; 255; 40
      Line Style: Billboards
      Line Width: 0.05
    - Class: rviz_default_plugins/MarkerArray
      Name: Lidar clusters A (lidar_debug)
      Enabled: false
      Topic:
        Value: /lidar/debug/clusters_a
    - Class: rviz_default_plugins/MarkerArray
      Name: Lidar clusters B (lidar_debug)
      Enabled: false
      Topic:
        Value: /lidar/debug/clusters_b
    - Class: rviz_default_plugins/MarkerArray
      Name: Cone zones (lidar_debug)
      Enabled: false
      Topic:
        Value: /lidar/debug/zones
    - Class: rviz_default_plugins/Map
      Name: Avoid costmap (static_avoid)
      Enabled: false
      Topic:
        Value: /avoid/costmap
      Color Scheme: costmap
      Alpha: 0.6
    - Class: rviz_default_plugins/MarkerArray
      Name: Avoid candidates (static_avoid)
      Enabled: false
      Topic:
        Value: /avoid/candidates
    - Class: rviz_default_plugins/Path
      Name: Avoid path (static_avoid)
      Enabled: false
      Topic:
        Value: /avoid/path
      Color: 255; 80; 200
      Line Style: Billboards
      Line Width: 0.03
    - Class: rviz_default_plugins/MarkerArray
      Name: Avoid cues (entry line, island)
      Enabled: false
      Topic:
        Value: /avoid/cues
    - Class: rviz_default_plugins/PoseArray
      Name: LIMO clusters /lidar/limos
      Enabled: false
      Topic:
        Value: /lidar/limos
      Shape: Arrow (Flat)
      Color: 80; 160; 255
      Arrow Length: 0.1
    - Class: rviz_default_plugins/MarkerArray
      Name: Decision markers
      Enabled: true
      Topic:
        Value: /viz/markers
    - Class: rviz_default_plugins/Marker
      Name: Trail
      Enabled: true
      Topic:
        Value: /viz/trail
    - Class: rviz_default_plugins/Image
      Name: Overlay
      Enabled: true
      Topic:
        Value: /viz/overlay
    - Class: rviz_default_plugins/Image
      Name: Warped lane windows
      Enabled: true
      Topic:
        Value: /lane/debug_image
    - Class: rviz_default_plugins/Image
      Name: Stopline
      Enabled: false
      Topic:
        Value: /stopline/debug_image
    - Class: rviz_default_plugins/Image
      Name: Speed zone
      Enabled: false
      Topic:
        Value: /speed_zone/debug_image
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Follow car
      Target Frame: base_link
      Scale: 150
      Angle: 0
      X: 0.0
      Y: 0.0
      Invert Z Axis: false
    Saved: ~
Window Geometry:
  Height: 1000
  Width: 1700
