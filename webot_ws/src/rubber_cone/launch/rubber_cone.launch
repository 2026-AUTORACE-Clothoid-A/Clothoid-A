<launch>
    <!-- RViz -->
    <node type="rviz"
          name="rviz"
          pkg="rviz"
          args="-d $(find rubber_cone)/config/rubber_cone.rviz" />

    <!-- ===== rubber_cone_node ===== -->
    <node pkg="rubber_cone"
          type="rubber_cone_node"
          name="rubber_cone_node"
          output="screen">

        <!-- 기본 주행 파라미터 -->
        <param name="speed"                      value="0.4" />
        <param name="vehicle_length"             value="0.25" />
        <param name="lfd"                        value="0.6" />

        <param name="angle_from_left_first_cone"  value="45.0" />

        <!-- 첫 콘까지 허용 거리 -->
        <param name="dist_from_left_first_cone"  value="1.0" />
        <param name="dist_from_right_first_cone" value="1.0" />

        <!-- 인접 콘 간 최대 거리 -->
        <param name="dist_between_cones"         value="0.4" />

        <param name="max_turn_angle_deg" value="45.0" />
        <param name="weight_dist"        value="1.0" />
        <param name="weight_angle"       value="1.0" />

        <!-- 센터라인 스플라인 샘플 간격 (m) -->
        <param name="centerline_ds"              value="0.05" />

        <!-- 미션 START 영역: 0 < x < 1.3, -0.6 < y < 0.6, 개수 >= 6 -->
        <param name="start_x_min"                value="0.0" />
        <param name="start_x_max"                value="1.3" />
        <param name="start_y_min"                value="-0.6" />
        <param name="start_y_max"                value="0.6" />
        <param name="start_min_count"            value="6" />

        <!-- 미션 진행(ING) 영역: 0 < x < 2.0, -2.0 < y < 2.0, 개수 >= 4 -->
        <param name="ing_x_min"                  value="0.0" />
        <param name="ing_x_max"                  value="2.0" />
        <param name="ing_y_min"                  value="-2.0" />
        <param name="ing_y_max"                  value="2.0" />
        <param name="ing_min_count"              value="4" />

    </node>
</launch>
