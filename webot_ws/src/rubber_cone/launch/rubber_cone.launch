<launch>

    <!-- RViz -->
    <node type="rviz" name="rviz" pkg="rviz" args="-d $(find rubber_cone)/config/rubber_cone.rviz" />

    <node pkg="rubber_cone" type="cone_sorter_node" name="cone_sorter_node" output="screen">

        <!-- 기본 기하/탐색 파라미터 -->
        <param name="max_dist_to_first"        value="1.0" />
        <param name="max_dist_between_cones"   value="0.4" />
        <param name="max_n_neighbors"          value="10" />
        <param name="max_trace_length"         value="20" />

        <param name="threshold_directional_angle_deg" value="45.0" />
        <param name="threshold_absolute_angle_deg"    value="60.0" />

        <param name="ellipse_major_radius_factor" value="2.0" />
        <param name="ellipse_minor_radius_factor" value="1.0" />
        <param name="len_override_factor"         value="2.0" />

        <param name="car_size" value="0.5" />

        <!-- 비용 관련 파라미터 -->
        <param name="angle_cost_threshold_deg" value="45.0" />
        <param name="residual_dist_threshold"  value="0.4" />  <!-- 기본값: max_dist_between_cones_ -->

        <param name="wrong_dir_threshold_deg"  value="45.0" />

        <param name="cones_side_search_dist"      value="0.8" />
        <param name="cones_side_search_angle_deg" value="120.0" />

        <!-- 가중치 -->
        <param name="w_angle_cost"         value="1000.0" />
        <param name="w_residual_dist_cost" value="200.0" />
        <param name="w_num_cones_cost"     value="5000.0" />
        <param name="w_initial_dir_cost"   value="1000.0" />
        <param name="w_change_dir_cost"    value="2000.0" />
        <param name="w_cones_side_cost"    value="0.0" />
        <param name="w_wrong_dir_cost"     value="1000.0" />

        <!-- 러버콘 스타일 첫 점 선택용 -->
        <param name="angle_from_left_first_cone" value="45.0" />
        <param name="dist_from_left_first_cone"  value="0.5" />
        <param name="dist_from_right_first_cone" value="0.5" />

        <!-- 미션 판정 영역: start -->
        <param name="start_x_min"     value="0.0" />
        <param name="start_x_max"     value="1.3" />
        <param name="start_y_min"     value="-0.6" />
        <param name="start_y_max"     value="0.6" />
        <param name="start_min_count" value="6" />

        <!-- 미션 판정 영역: ing -->
        <param name="ing_x_min"       value="0.0" />
        <param name="ing_x_max"       value="1.0" />
        <param name="ing_y_min"       value="-1.0" />
        <param name="ing_y_max"       value="1.0" />
        <param name="ing_min_count"   value="4" />

    </node>

    <node pkg="rubber_cone" type="rubber_cone_node" name="rubber_cone_node" output="screen">

        <!-- 주행 관련 파라미터 -->
        <param name="speed"          value="0.3" />
        <param name="vehicle_length" value="0.25" />
        <param name="lfd"            value="0.6" />
        <param name="centerline_ds"  value="0.05" />
        <param name="approx_track_width"  value="0.7" />
        <param name="lsq_window_size"  value="9" />
        <param name="boundary_timeout"  value="0.1" />

    </node>

</launch>
